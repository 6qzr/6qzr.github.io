---
import { person } from "../data/site";
---

<section class="section" id="contact">
  <div class="shell">
    <div class="contact glass-deep" data-reveal>
      <p class="t-eyebrow contact__eyebrow">Get in touch</p>

      <h2 class="t-h2 on-glass contact__title">
        If any of this is useful to you, say hello.
      </h2>

      <p class="t-body on-glass-soft contact__note">
        I am open to software engineering, .NET, and application security roles —
        and equally happy to talk about a problem you are stuck on.
      </p>

      <div class="contact__actions">
        <a class="btn btn--primary press" href={`mailto:${person.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2.5" />
            <path d="m3.5 7 8.5 6 8.5-6" />
          </svg>
          {person.email}
        </a>

        <a class="btn btn--glass glass press" href={person.cv} download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" />
          </svg>
          Download CV
        </a>
      </div>

      <ul class="contact__socials">
        <li>
          <a class="social press" href={person.github} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z" />
            </svg>
            <span>GitHub</span>
            <span class="social__handle">@{person.githubHandle}</span>
          </a>
        </li>
        <li>
          <a class="social press" href={person.linkedin} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9.75h4v11.25H3zM9.5 9.75h3.83v1.54h.05c.53-.96 1.84-1.97 3.79-1.97 4.05 0 4.8 2.53 4.8 5.82v5.86h-4v-5.2c0-1.24-.02-2.84-1.77-2.84-1.78 0-2.05 1.35-2.05 2.75v5.29h-4z" />
            </svg>
            <span>LinkedIn</span>
            <span class="social__handle">Mohammed Al Abri</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: var(--spacing-phi-6) 1rem var(--spacing-phi-5);
  }

  .shell {
    width: min(100%, 60rem);
    margin-inline: auto;
  }

  .contact {
    padding: clamp(1.6rem, 4vw, 3.25rem);
    border-radius: clamp(1.25rem, 2.5vw, 2rem);
    text-align: center;
  }

  .contact__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
  }
  .contact__title {
    max-width: 22ch;
    margin: 0 auto var(--spacing-phi-2);
    text-wrap: balance;
  }
  .contact__note {
    max-width: 52ch;
    margin: 0 auto var(--spacing-phi-3);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    transition: background-color 160ms ease;
    /* Long email addresses must not blow out the layout on a narrow phone. */
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  .btn--primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 6px 20px -6px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, #000);
  }
  .btn--glass {
    color: var(--ink);
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-phi-2);
    margin: var(--spacing-phi-3) 0 0;
    padding: var(--spacing-phi-3) 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .social:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .social svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .social__handle {
    color: var(--ink-faint);
    font-weight: 400;
  }
</style>
