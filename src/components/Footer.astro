---
import { person, nav } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <!-- Torn edge, echoing the reference footer: the page tears away and the
       ground shows through underneath. -->
  <svg class="footer__tear" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 30 C 40 18, 78 40, 120 28 C 168 14, 205 36, 248 26 C 292 16, 330 38, 374 27 C 420 15, 458 37, 502 26 C 548 14, 586 36, 630 25 C 676 13, 714 35, 758 25 C 804 15, 842 37, 886 27 C 932 16, 970 38, 1014 28 C 1060 17, 1098 39, 1142 29 C 1188 18, 1226 40, 1270 30 C 1316 19, 1354 41, 1398 31 C 1416 27, 1430 25, 1440 24 L 1440 48 L 0 48 Z"
      fill="currentColor"
    />
  </svg>

  <div class="footer__body">
    <div class="shell footer__grid">
      <div class="footer__brand">
        <p class="footer__name">{person.name}</p>
        <p class="t-small footer__tag">
          Full-stack developer and cybersecurity practitioner. {person.location}.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Footer">
        <p class="t-eyebrow footer__label">Sections</p>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__nav">
        <p class="t-eyebrow footer__label">Elsewhere</p>
        <ul>
          <li><a href={person.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={`mailto:${person.email}`}>Email</a></li>
          <li><a href={person.cv} download>Curriculum vitae</a></li>
        </ul>
      </div>
    </div>

    <div class="shell footer__base">
      <p class="t-small">© {year} {person.fullName}</p>
      <p class="t-small">
        Built with Astro. Deployed by GitHub.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: var(--spacing-phi-5);
    color: var(--scene-ground);
  }

  .footer__tear {
    display: block;
    width: 100%;
    height: 3rem;
    /* `currentColor` is the ground colour, so the tear and the slab below it
       are guaranteed to match in both themes. */
  }

  .footer__body {
    background: var(--scene-ground);
    padding:
      var(--spacing-phi-4)
      max(1rem, env(safe-area-inset-right))
      max(var(--spacing-phi-2), env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    color: rgb(255 255 255 / 0.92);
  }

  .shell {
    width: min(100%, 68rem);
    margin-inline: auto;
  }

  .footer__grid {
    display: grid;
    gap: var(--spacing-phi-3);
  }

  .footer__name {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .footer__tag {
    margin: 0;
    max-width: 34ch;
    color: rgb(255 255 255 / 0.72);
  }

  .footer__label {
    margin: 0 0 0.7rem;
    color: rgb(255 255 255 / 0.55);
  }

  .footer__nav ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__nav a {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .footer__nav a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer__nav a:focus-visible {
    outline-color: #fff;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: var(--spacing-phi-4);
    padding-top: var(--spacing-phi-2);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.6);
  }
  .footer__base p {
    margin: 0;
  }

  @media (min-width: 46rem) {
    .footer__grid {
      grid-template-columns: 1.618fr 1fr 1fr;
      gap: var(--spacing-phi-4);
    }
  }
</style>
