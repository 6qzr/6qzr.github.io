---
import { person } from "../data/site";

const lines = person.headline.split("\n");
---

<section class="hero" id="top">
  <div class="hero__inner">
    <p class="hero__eyebrow t-eyebrow on-scene">
      <span class="hero__dot" aria-hidden="true"></span>
      {person.location}
    </p>

    <h1 class="t-display on-scene hero__headline">
      {lines.map((line) => <span class="hero__line">{line}</span>)}
    </h1>

    <p class="hero__lede t-body on-scene">
      {person.summary}
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary press" href="#work">
        See the work
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h13M12 5l7 7-7 7" />
        </svg>
      </a>
      <a class="btn btn--glass glass press" href={person.cv} download>
        Download CV
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" />
        </svg>
      </a>
    </div>

    <!-- Two disciplines, stated once, near the top. -->
    <ul class="hero__tracks">
      {person.roles.map((role) => (
        <li class="hero__track glass">{role}</li>
      ))}
    </ul>
  </div>

  <a class="hero__cue on-scene" href="#about" aria-label="Scroll to about">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 7rem 1rem 5rem;
    text-align: center;
  }

  .hero__inner {
    width: min(100%, 54rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Golden-ratio rhythm, from the token scale. */
    gap: var(--spacing-phi-3);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .hero__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .hero__headline {
    margin: 0;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
  }

  .hero__lede {
    max-width: 44ch;
    margin: 0;
    /* Slightly heavier than body default: this sits over a moving scene. */
    font-weight: 450;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    letter-spacing: -0.003em;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .btn--primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 6px 20px -6px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, #000);
  }

  .btn--glass {
    color: var(--ink);
  }
  .btn--glass:hover {
    background: var(--glass-bg-deep);
  }

  .hero__tracks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: var(--spacing-phi-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__track {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.004em;
    color: var(--ink);
  }

  .hero__cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 2.4rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    opacity: 0.55;
  }
  .hero__cue span {
    display: block;
    width: 3px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
    animation: cue 1.9s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  @keyframes cue {
    0%   { transform: translateY(-6px); opacity: 0; }
    35%  { opacity: 1; }
    100% { transform: translateY(6px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue span { animation: none; }
  }
</style>
