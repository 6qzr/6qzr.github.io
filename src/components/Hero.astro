---
import { person } from "../data/site";

const lines = person.headline.split("\n");
---

<section class="hero" id="top">
  <div class="hero__shell">
    <div class="hero__inner">
      <p class="hero__eyebrow t-eyebrow on-scene">
        <span class="hero__dot" aria-hidden="true"></span>
        {person.location}
        <span class="hero__sep" aria-hidden="true">·</span>
        {person.roles.join(" · ")}
      </p>

      <h1 class="t-display on-scene hero__headline">
        {lines.map((line) => <span class="hero__line">{line}</span>)}
      </h1>

      <p class="hero__lede t-body on-scene">
        {person.summary}
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary press" href="#work">
          See the work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M12 5l7 7-7 7" />
          </svg>
        </a>
        <a class="btn btn--glass glass press" href={person.cv} download>
          Download CV
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <a class="hero__cue on-scene" href="#about" aria-label="Scroll to about">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  /*
    The photograph puts a figure at a desk dead centre. Hero copy therefore
    lives in the upper left, over sky and mountain, so the two never fight for
    the same pixels — and the person in the meadow stays the thing you look at.
  */
  .hero {
    position: relative;
    display: grid;
    align-content: start;
    min-height: 100svh;
    padding: clamp(6.5rem, 16vh, 9.5rem) 1rem 5rem;
  }

  /*
    A local wash behind the copy. The scene scrim only darkens the top band, so
    on a short viewport the lede and buttons would land on sunlit grass and lose
    all contrast. Anchoring a soft diagonal gradient to the hero itself means
    the copy carries its own legibility wherever it falls — and it reads as
    atmosphere rather than as a panel.
  */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      102deg,
      rgb(4 16 28 / 0.66) 0%,
      rgb(4 16 28 / 0.46) 26%,
      rgb(4 16 28 / 0.16) 48%,
      rgb(4 16 28 / 0) 66%
    );
    /* The wash is bounded by the hero, but the scene behind it keeps going.
       Feather the bottom edge or the gradient ends in a hard horizontal seam
       straight across the mountains. */
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
  }

  .hero__shell {
    position: relative;
    width: min(100%, 72rem);
    margin-inline: auto;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Wide enough for the headline to hold two lines; the lede is constrained
       separately so the reading measure stays comfortable. */
    max-width: 54rem;
    gap: var(--spacing-phi-3);
    text-align: left;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .hero__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 28%, transparent);
    flex: none;
  }
  .hero__sep {
    opacity: 0.5;
  }

  .hero__headline {
    margin: 0;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
  }

  .hero__lede {
    max-width: 40ch;
    margin: 0;
    /* Slightly heavier than body default: this sits over a photograph. */
    font-weight: 450;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    letter-spacing: -0.003em;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .btn--primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 6px 20px -6px rgb(4 16 28 / 0.5);
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, #000);
  }

  .btn--glass {
    /* Over the photograph this button is on a dark field in both themes, so it
       takes light text rather than the theme's body ink. */
    color: #fff;
    background: rgb(255 255 255 / 0.14);
    border-color: rgb(255 255 255 / 0.32);
  }
  .btn--glass:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .hero__cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 2.4rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    opacity: 0.55;
  }
  .hero__cue span {
    display: block;
    width: 3px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
    animation: cue 1.9s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  @keyframes cue {
    0%   { transform: translateY(-6px); opacity: 0; }
    35%  { opacity: 1; }
    100% { transform: translateY(6px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue span { animation: none; }
  }

  /* On a phone the photo crops tight around the figure, so the copy centres
     again in the sky band above it — and the wash becomes vertical to match. */
  @media (max-width: 40rem) {
    .hero::before {
      background: linear-gradient(
        to bottom,
        rgb(4 16 28 / 0.66) 0%,
        rgb(4 16 28 / 0.5) 42%,
        rgb(4 16 28 / 0.18) 68%,
        rgb(4 16 28 / 0) 88%
      );
    }
    .hero__inner {
      align-items: center;
      text-align: center;
    }
    .hero__actions,
    .hero__eyebrow {
      justify-content: center;
    }
  }
</style>
