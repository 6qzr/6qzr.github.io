---
/**
 * The fixed landscape that every glass surface floats above.
 *
 * Behind the photograph sits a 430-byte blurred copy of the same photograph,
 * so the first paint already looks like the scene that is loading. An earlier
 * version used a drawn SVG landscape here, which was visibly a different
 * picture and flashed on every refresh.
 *
 * The placeholder comes in as `--scene-placeholder` from a generated
 * stylesheet rather than a style attribute on the element: the CSP hashes
 * stylesheets but cannot hash style attributes, so an inline one is blocked.
 */
const widths = [480, 800, 1200, 1670];
const webpSet = widths.map((w) => `/images/scene-${w}.webp ${w}w`).join(", ");
const jpgSet = widths.map((w) => `/images/scene-${w}.jpg ${w}w`).join(", ");
---

<div class="scene" aria-hidden="true">
  <div class="scene__placeholder"></div>

  <picture>
    <source type="image/webp" srcset={webpSet} sizes="100vw" />
    <img
      class="scene__photo"
      src="/images/scene-1670.jpg"
      srcset={jpgSet}
      sizes="100vw"
      alt=""
      width="1670"
      height="941"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <!-- Legibility scrim. Content sits on top of this, the scene below it. -->
  <div class="scene__scrim"></div>
</div>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-color: var(--bg);
  }

  .scene__placeholder,
  .scene__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bias the crop slightly upward so the figure at the desk keeps its
       breathing room on short, wide viewports. */
    object-position: 50% 46%;
  }

  .scene__placeholder {
    background-image: var(--scene-placeholder);
    background-size: cover;
    background-position: 50% 46%;
    /* Scaled up so the 32px source has no visible pixel edges, and blurred so
       the handover to the full photo is imperceptible. */
    transform: scale(1.06);
    filter: blur(18px);
  }

  /* Dusk is the same place at a different hour, so the photo is graded rather
     than swapped for a second image. The placeholder is graded identically,
     otherwise it would flash bright before the photo lands. */
  :global(.dark) .scene__photo,
  :global(.dark) .scene__placeholder {
    filter: brightness(0.5) saturate(0.8) contrast(1.04) hue-rotate(-6deg);
  }
  :global(.dark) .scene__placeholder {
    filter: brightness(0.5) saturate(0.8) contrast(1.04) hue-rotate(-6deg) blur(18px);
  }

  /*
    In daylight this does one job only: fade the photo into the page background
    low down, where the glass panels live. It deliberately does NOT darken the
    sky, because stacking a scene scrim under the hero's own wash drained the
    brightness out of the photograph. Legibility is the hero's problem, handled
    locally there.
  */
  .scene__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg) 0%, rgb(0 0 0 / 0) 34%);
  }
  /* At dusk the photo is already graded down, so it needs only a light cool
     wash to settle it. */
  :global(.dark) .scene__scrim {
    background:
      linear-gradient(to bottom, rgb(3 11 19 / 0.3) 0%, rgb(3 11 19 / 0) 42%),
      linear-gradient(to top, var(--bg) 0%, rgb(0 0 0 / 0) 34%);
  }
</style>
