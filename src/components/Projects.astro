---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="section" id="work">
  <div class="shell">
    <header class="head" data-reveal>
      <p class="t-eyebrow head__eyebrow on-scene">Selected work</p>
      <h2 class="t-h2 on-scene head__title">Two projects, one for each half.</h2>
      <p class="t-body head__note on-scene">
        Rather than a long grid of coursework, here are the two that actually
        carry weight: the graduation project that finds vulnerabilities, and
        the capstone API I led a team of four to build.
      </p>
    </header>

    <div class="grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>

    <p class="more t-small on-scene" data-reveal>
      Everything else, from C# and Java coursework to SQL practice and
      front-end experiments, lives on
      <a href="https://github.com/6qzr" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: var(--spacing-phi-6) 1rem;
  }

  .shell {
    width: min(100%, 72rem);
    margin-inline: auto;
  }

  .head {
    max-width: 50ch;
    margin: 0 auto var(--spacing-phi-4);
    text-align: center;
  }
  .head__eyebrow { margin: 0 0 0.75rem; }
  .head__title   { margin: 0 0 var(--spacing-phi-2); }
  .head__note    { margin: 0; opacity: 0.88; }

  .grid {
    display: grid;
    gap: var(--spacing-phi-2);
  }

  .more {
    margin: var(--spacing-phi-3) 0 0;
    text-align: center;
    opacity: 0.85;
  }
  .more a {
    color: inherit;
    text-underline-offset: 3px;
  }

  @media (min-width: 58rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-phi-3);
      align-items: stretch;
    }
  }
</style>
