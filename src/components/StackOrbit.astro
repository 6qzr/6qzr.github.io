---
import { stack, stackGroupLabels, type StackGroup } from "../data/site";

/**
 * The guide spiral drawn behind the cards, generated with the same law the
 * animation uses — r(theta) = r0 * phi^(theta / (pi/2)) — so the path the cards
 * travel is literally the path you can see.
 */
const PHI = 1.618033988749895;
const QUARTER_TURN = Math.PI / 2;
const RADIUS_RATIO = 12;
const THETA_SPAN = (Math.log(RADIUS_RATIO) / Math.log(PHI)) * QUARTER_TURN;

const VIEW = 600;
const CENTER = VIEW / 2;
const R_MAX = CENTER - 64;
const R_MIN = R_MAX / RADIUS_RATIO;

const points: string[] = [];
for (let i = 0; i <= 200; i += 1) {
  const theta = (i / 200) * THETA_SPAN;
  const r = R_MIN * Math.pow(PHI, theta / QUARTER_TURN);
  points.push(
    `${(CENTER + Math.cos(theta) * r).toFixed(2)},${(CENTER + Math.sin(theta) * r).toFixed(2)}`,
  );
}
const spiralPath = `M ${points.join(" L ")}`;

/** Grouped list, used as the static fallback and as the accessible content. */
const grouped = (Object.keys(stackGroupLabels) as StackGroup[]).map((group) => ({
  group,
  label: stackGroupLabels[group],
  items: stack.filter((item) => item.group === group),
}));
---

<section class="section" id="stack">
  <div class="shell">
    <header class="head" data-reveal>
      <p class="t-eyebrow head__eyebrow on-scene">What I work with</p>
      <h2 class="t-h2 on-scene head__title">The stack, on a golden spiral.</h2>
      <p class="t-body on-scene head__note">
        Each card grows as it travels outward along a logarithmic spiral that
        widens by exactly phi every quarter turn. Rest the pointer on it to hold
        it still.
      </p>
    </header>

    <div class="orbit-wrap" data-reveal>
      <div class="orbit" data-orbit>
        <svg class="orbit__guide" viewBox={`0 0 ${VIEW} ${VIEW}`} aria-hidden="true">
          <path d={spiralPath} fill="none" stroke="currentColor" stroke-width="1" />
          <circle cx={CENTER} cy={CENTER} r="2.5" fill="currentColor" />
        </svg>

        {stack.map((item) => (
          <span
            class:list={["chip", "glass", { "chip--security": item.group === "security" }]}
            data-orbit-card
          >
            <span class="chip__dot" aria-hidden="true"></span>
            {item.name}
          </span>
        ))}
      </div>
    </div>

    <!--
      The moving cards are decorative duplicates of this list. Keeping a plain,
      grouped version in the DOM means the information survives without motion,
      without JavaScript, and in a screen reader.
    -->
    <div class="legend" data-reveal>
      {grouped.map((section) => (
        <div class="legend__group">
          <h3 class="t-eyebrow legend__label">{section.label}</h3>
          <ul>
            {section.items.map((item) => <li class="t-small on-scene">{item.name}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { initOrbit } from "../scripts/orbit";

  const container = document.querySelector<HTMLElement>("[data-orbit]");
  if (container) initOrbit(container);
</script>

<style>
  .section {
    position: relative;
    padding: var(--spacing-phi-6) 1rem;
  }

  .shell {
    width: min(100%, 68rem);
    margin-inline: auto;
  }

  .head {
    max-width: 48ch;
    margin: 0 auto var(--spacing-phi-4);
    text-align: center;
  }
  .head__eyebrow { margin: 0 0 0.75rem; }
  .head__title   { margin: 0 0 var(--spacing-phi-2); }
  .head__note    { margin: 0; opacity: 0.85; }

  .orbit-wrap {
    display: grid;
    place-items: center;
  }

  .orbit {
    position: relative;
    width: min(100%, 38rem);
    aspect-ratio: 1;
  }

  .orbit__guide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
    opacity: 0.12;
    pointer-events: none;
  }

  .chip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.004em;
    color: var(--ink);
    white-space: nowrap;
    /* The script writes transform and opacity every frame; both stay on the
       compositor. */
    will-change: transform, opacity;
  }

  .chip__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }
  .chip--security .chip__dot {
    background: var(--sun-500);
  }
  :global(.dark) .chip--security .chip__dot {
    background: var(--sun-400);
  }

  /* Reduced motion: the spiral becomes an ordinary, readable cluster. */
  .orbit.is-static {
    aspect-ratio: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .orbit.is-static .orbit__guide {
    display: none;
  }
  .orbit.is-static .chip {
    position: static;
    transform: none;
    opacity: 1;
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--spacing-phi-3);
    margin-top: var(--spacing-phi-4);
  }
  .legend__label {
    margin: 0 0 0.6rem;
    color: var(--accent);
  }
  .legend ul {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* On phones the spiral is too small to read, so show the grouped list only. */
  @media (max-width: 40rem) {
    .orbit-wrap { display: none; }
  }

  /* Wide enough for the spiral: the legend becomes visually redundant, but it
     stays in the accessibility tree rather than being removed with
     `display: none`, because it is the only grouped reading of the stack. */
  @media (min-width: 40.0625rem) {
    .legend {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
