---
import { stack, stackGroupLabels, type StackGroup } from "../data/site";

/**
 * The guide spiral drawn behind the cards, generated with the same law the
 * animation uses — r(theta) = r0 * phi^(theta / (pi/2)) — so the path the cards
 * travel is literally the path you can see.
 */
const PHI = 1.618033988749895;
const QUARTER_TURN = Math.PI / 2;
const RADIUS_RATIO = 6;
const THETA_SPAN = (Math.log(RADIUS_RATIO) / Math.log(PHI)) * QUARTER_TURN;

const VIEW = 600;
const CENTER = VIEW / 2;
const R_MAX = CENTER - 80;
const R_MIN = R_MAX / RADIUS_RATIO;

const points: string[] = [];
for (let i = 0; i <= 200; i += 1) {
  const theta = (i / 200) * THETA_SPAN;
  const r = R_MIN * Math.pow(PHI, theta / QUARTER_TURN);
  points.push(
    `${(CENTER + Math.cos(theta) * r).toFixed(2)},${(CENTER + Math.sin(theta) * r).toFixed(2)}`,
  );
}
const spiralPath = `M ${points.join(" L ")}`;

/** Only the spotlight entries ride the spiral. See the note in site.ts. */
const orbiting = stack.filter((item) => item.spotlight);

/** Grouped list, used as the static fallback and as the accessible content. */
const grouped = (Object.keys(stackGroupLabels) as StackGroup[]).map((group) => ({
  group,
  label: stackGroupLabels[group],
  items: stack.filter((item) => item.group === group),
}));
---

<section class="section" id="stack">
  <div class="shell">
    <!--
      The heading sits in the column with the list rather than centred above
      the whole thing. Floating on its own over a two-column layout, it read
      as detached from both halves.
    -->
    <div class="split">
      <div class="orbit-wrap" data-reveal>
        <div class="orbit" data-orbit>
          <svg class="orbit__guide" viewBox={`0 0 ${VIEW} ${VIEW}`} aria-hidden="true">
            <path d={spiralPath} fill="none" stroke="currentColor" stroke-width="1" />
            <circle cx={CENTER} cy={CENTER} r="2.5" fill="currentColor" />
          </svg>

          {orbiting.map((item) => (
            <span
              class:list={["chip", "glass", { "chip--security": item.group === "security" }]}
              data-orbit-card
            >
              <span class="chip__dot" aria-hidden="true"></span>
              {item.name}
            </span>
          ))}
        </div>
      </div>

      <div class="side">
        <header class="head" data-reveal>
          <p class="t-eyebrow head__eyebrow on-scene">What I work with</p>
          <h2 class="t-h2 on-scene head__title">Tools I reach for.</h2>
          <p class="t-body on-scene head__note">
            Backend and data on one side, and the tooling I use to keep it
            secure on the other.
          </p>
        </header>

        <!--
          The spiral shows only the headline tools, and it moves. This grouped
          list is the authoritative one: it carries everything, it is readable
          at a glance, and it survives with no motion, no JavaScript and a
          screen reader.
        -->
        <div class="legend glass-deep" data-reveal data-reveal-delay="90">
          {grouped.map((section) => (
            <div class="legend__group">
              <h3 class="t-eyebrow legend__label">{section.label}</h3>
              <ul>
                {/* on-glass-soft, not on-scene: this list sits on a glass
                    panel, and on-scene carries a dark halo meant for text over
                    the photograph, which reads as a smudge here. */}
                {section.items.map((item) => <li class="t-small on-glass-soft">{item.name}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initOrbit } from "../scripts/orbit";

  const container = document.querySelector<HTMLElement>("[data-orbit]");
  if (container) initOrbit(container);
</script>

<style>
  .section {
    position: relative;
    padding: var(--spacing-phi-3) 1rem;
  }

  .shell {
    width: min(100%, 68rem);
    margin-inline: auto;
  }

  .head {
    max-width: 48ch;
    margin: 0 auto var(--spacing-phi-2);
    text-align: center;
  }
  .head__eyebrow { margin: 0 0 0.6rem; }
  .head__title   { margin: 0 0 0.6rem; }
  .head__note    { margin: 0; opacity: 0.85; }

  .split {
    display: grid;
    gap: var(--spacing-phi-3);
    align-items: center;
  }

  .side {
    display: grid;
    gap: var(--spacing-phi-2);
  }

  .orbit-wrap {
    display: grid;
    place-items: center;
  }

  .orbit {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 1;
  }

  .orbit__guide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
    opacity: 0.16;
    pointer-events: none;
  }

  .chip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: 0.002em;
    color: var(--ink);
    white-space: nowrap;
    /* The script writes transform and opacity every frame; both stay on the
       compositor. */
    will-change: transform, opacity;
  }

  .chip__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }
  .chip--security .chip__dot {
    background: var(--sun-500);
  }
  :global(.dark) .chip--security .chip__dot {
    background: var(--sun-400);
  }

  /* Reduced motion: the spiral becomes an ordinary, readable cluster. */
  .orbit.is-static {
    aspect-ratio: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .orbit.is-static .orbit__guide {
    display: none;
  }
  .orbit.is-static .chip {
    position: static;
    transform: none;
    opacity: 1;
  }

  /*
    Multi-column, not grid.

    As a two-column grid the row heights were set by the tallest group in each
    row, so Security (six items) stretched its row and left Data stranded above
    a gap with Delivery pushed down below it. Columns flow the groups instead,
    so each one starts directly under the last.
  */
  .legend {
    columns: 1;
    column-gap: var(--spacing-phi-3);
    padding: clamp(1.1rem, 2.5vw, 1.618rem);
    border-radius: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .legend__group {
    break-inside: avoid;
    margin-bottom: var(--spacing-phi-2);
  }
  .legend__group:last-child {
    margin-bottom: 0;
  }
  .legend__label {
    margin: 0 0 0.6rem;
    color: var(--accent);
  }
  .legend ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wide enough for both: the spiral beside the list keeps the section to a
     single slide instead of stacking to more than one and a half. */
  @media (min-width: 62rem) {
    .split {
      grid-template-columns: 1fr 0.95fr;
      gap: var(--spacing-phi-4);
    }
    /* Left-aligned in its column: centred text beside a circle looks like it
       is trying and failing to line up with something. */
    .head {
      margin: 0 0 var(--spacing-phi-2);
      text-align: left;
    }
    .legend {
      columns: 2;
    }
  }

  /*
    The spiral is the centrepiece, so it stays on phones. It only needs the
    chips scaled down to suit the smaller radius; hiding it was the wrong
    answer to them overlapping.
  */
  @media (max-width: 40rem) {
    .orbit {
      width: min(100%, 22rem);
    }
    .chip {
      gap: 0.3rem;
      padding: 0.26rem 0.55rem;
      font-size: 0.72rem;
    }
    .chip__dot {
      width: 0.3rem;
      height: 0.3rem;
    }
    /*
      Show every other chip. A 352px spiral cannot hold nine readable pills:
      adjacent ones overlapped by half. Hiding alternates doubles the spacing
      along the same path, and nothing is lost because the chips are a moving
      duplicate of the grouped list below.
    */
    .chip:nth-of-type(even) {
      display: none;
    }
  }
</style>
