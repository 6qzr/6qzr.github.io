---
/**
 * Midday / dusk switch. `aria-pressed` and the label are kept in sync by
 * scripts/theme.ts, which also owns the persisted value.
 */
---

<button
  type="button"
  class="toggle press"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <span class="toggle__icons" aria-hidden="true">
    <!-- Sun -->
    <svg class="toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
    </svg>
    <!-- Moon -->
    <svg class="toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
    </svg>
  </span>
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    flex: none;
  }
  .toggle:hover {
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }

  .toggle__icons {
    position: relative;
    display: block;
    width: 1.15rem;
    height: 1.15rem;
  }

  .toggle__icons svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* The two icons swap along the same arc in both directions, so the
       transition is symmetric however it is triggered. */
    transition:
      opacity 220ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .toggle__sun  { opacity: 1; transform: rotate(0) scale(1); }
  .toggle__moon { opacity: 0; transform: rotate(-70deg) scale(0.6); }

  :global(.dark) .toggle__sun  { opacity: 0; transform: rotate(70deg) scale(0.6); }
  :global(.dark) .toggle__moon { opacity: 1; transform: rotate(0) scale(1); }
</style>
