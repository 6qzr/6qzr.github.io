---
import { timeline, certificates } from "../data/site";

/**
 * Two slides.
 *
 * Every section has to fit a single screen for the snap scrolling to work.
 * Four roles plus the certificates on one screen meant shrinking the type and
 * padding until it read as cramped, so experience and education are split.
 *
 * Experience keeps the vertical timeline: a marker per entry threaded on a
 * single line. Laid out as a row of three cards instead, the entries have
 * different amounts to say and the unequal heights read as broken, where on a
 * timeline they read as simply being different lengths.
 */
const experience = timeline.filter((entry) => entry.kind === "work");
const education = timeline.filter((entry) => entry.kind === "education");
---

<section class="section" id="path">
  <div class="shell">
    <header class="head" data-reveal>
      <p class="t-eyebrow head__eyebrow on-scene">The path so far</p>
      <h2 class="t-h2 on-scene head__title">Where I have been.</h2>
    </header>

    <ol class="timeline">
      {experience.map((entry, index) => (
        <li class="entry">
          <div class="entry__marker" aria-hidden="true">
            <span class="entry__dot"></span>
          </div>

          {/*
            data-reveal belongs on the glass panel, not on a wrapper around it.
            A filling opacity animation creates a stacking context, so on the
            wrapper the panel's backdrop-filter samples that group rather than
            the page behind, leaving the blur with nothing to blur. These
            panels looked noticeably more transparent than every other card.
          */}
          <div class="entry__panel glass-deep" data-reveal data-reveal-delay={index * 80}>
            <div class="entry__meta">
              <p class="t-small entry__when">{entry.start} to {entry.end}</p>
              <p class="t-small entry__where">{entry.place}</p>
            </div>

            <h3 class="on-glass entry__role">{entry.role}</h3>
            <p class="t-small entry__org">{entry.org}</p>

            <ul class="entry__points">
              {entry.points.map((point) => (
                <li class="t-small on-glass-soft">{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section" id="education">
  <div class="shell">
    <header class="head" data-reveal>
      <p class="t-eyebrow head__eyebrow on-scene">Where it started</p>
      <h2 class="t-h2 on-scene head__title">Education and certificates.</h2>
    </header>

    <!-- Side by side, so the slide is one composition rather than two small
         things stranded in a lot of space. -->
    <div class="edu">
      {education.map((entry) => (
        <div class="entry__panel entry__panel--edu glass-deep" data-reveal>
          <div class="entry__meta">
            <p class="t-small entry__when">{entry.start} to {entry.end}</p>
            <p class="t-small entry__where">{entry.place}</p>
          </div>

          <h3 class="on-glass entry__role">{entry.role}</h3>
          <p class="t-small entry__org entry__org--edu">{entry.org}</p>

          <ul class="entry__points">
            {entry.points.map((point) => (
              <li class="t-small on-glass-soft">{point}</li>
            ))}
          </ul>
        </div>
      ))}

      <div class="certs glass-deep" data-reveal data-reveal-delay="90">
        <h3 class="t-eyebrow certs__title">Certificates</h3>
        <ul class="certs__list">
          {certificates.map((certificate) => (
            <li>
              <span class="on-glass certs__name">
                {certificate.url ? (
                  <a href={certificate.url} target="_blank" rel="noopener noreferrer">
                    {certificate.name}
                  </a>
                ) : (
                  certificate.name
                )}
              </span>
              <span class="t-small certs__issuer">{certificate.issuer}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: var(--spacing-phi-3) 1rem;
  }

  .shell {
    width: min(100%, 58rem);
    margin-inline: auto;
  }

  .head {
    max-width: 44ch;
    margin: 0 auto var(--spacing-phi-2);
    text-align: center;
  }
  .head__eyebrow { margin: 0 0 0.6rem; }
  .head__title   { margin: 0; }

  .timeline {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 1rem;
  }

  /* The thread. Drawn on the marker column so it tracks the panels exactly,
     whatever height they end up. */
  .entry__marker {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .entry__marker::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -0.8rem;
    width: 1px;
    background: color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .entry:last-of-type .entry__marker::before {
    display: none;
  }

  .entry__dot {
    position: relative;
    margin-top: 1.5rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .entry__panel {
    padding: clamp(1rem, 2vw, 1.35rem);
    border-radius: 1.25rem;
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .entry__when,
  .entry__where {
    margin: 0;
    color: var(--ink-faint);
  }

  .entry__role {
    margin: 0;
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    line-height: 1.22;
    letter-spacing: -0.008em;
    font-weight: 600;
  }
  .entry__org {
    margin: 0.18rem 0 0;
    color: var(--accent);
    font-weight: 500;
  }
  .entry__org--edu {
    color: var(--sun-500);
  }
  :global(.dark) .entry__org--edu {
    color: var(--sun-400);
  }

  .entry__points {
    display: grid;
    gap: 0.35rem;
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
  }
  .entry__points li {
    padding-left: 0.15rem;
  }
  .entry__points li::marker {
    color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .edu {
    display: grid;
    gap: var(--spacing-phi-2);
  }

  .certs {
    padding: clamp(1.1rem, 2.5vw, 1.618rem);
    border-radius: 1.5rem;
  }
  .certs__title {
    margin: 0 0 var(--spacing-phi-2);
    color: var(--accent);
  }
  .certs__list {
    display: grid;
    gap: var(--spacing-phi-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .certs__list li {
    display: grid;
    gap: 0.1rem;
  }
  .certs__name {
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .certs__name a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .certs__issuer {
    color: var(--ink-faint);
  }

  @media (min-width: 58rem) {
    /*
      Equal columns, and no align-items: start. The degree panel used to be
      the wider of the two and each panel took its own content height, so two
      cards sitting side by side were visibly different in both dimensions,
      which reads as a mistake rather than as a choice. Stretching is the grid
      default; the whitespace under the shorter list is the price of a pair
      that matches.
    */
    .edu {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
