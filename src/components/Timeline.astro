---
import { timeline, certificates } from "../data/site";

/**
 * Two slides, not one.
 *
 * Every section has to fit a single screen for the snap scrolling to work.
 * Squeezing four roles plus the certificates into one screen meant shrinking
 * the type and the padding until the whole thing read as cramped. Splitting
 * experience from education gives both room to breathe and still fits.
 */
const experience = timeline.filter((entry) => entry.kind === "work");
const education = timeline.filter((entry) => entry.kind === "education");
---

<section class="section" id="path">
  <div class="shell">
    <header class="head" data-reveal>
      <p class="t-eyebrow head__eyebrow on-scene">The path so far</p>
      <h2 class="t-h2 on-scene head__title">Where I have been.</h2>
    </header>

    <ol class="timeline timeline--experience">
      {experience.map((entry, index) => (
        <li class="entry">
          {/*
            data-reveal belongs on the glass panel, not on a wrapper around it.
            A filling opacity animation creates a stacking context, so on the
            wrapper the panel's backdrop-filter samples that group rather than
            the page behind, leaving the blur with nothing to blur. These
            panels looked noticeably more transparent than every other card.
          */}
          <div class="entry__panel glass-deep" data-reveal data-reveal-delay={index * 90}>
            <div class="entry__meta">
              <p class="t-small entry__when">{entry.start} to {entry.end}</p>
              <p class="t-small entry__where">{entry.place}</p>
            </div>

            <h3 class="on-glass entry__role">{entry.role}</h3>
            <p class="t-small entry__org">{entry.org}</p>

            <ul class="entry__points">
              {entry.points.map((point) => (
                <li class="t-small on-glass-soft">{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section" id="education">
  <div class="shell shell--narrow">
    <header class="head" data-reveal>
      <p class="t-eyebrow head__eyebrow on-scene">Where it started</p>
      <h2 class="t-h2 on-scene head__title">Education and certificates.</h2>
    </header>

    <ol class="timeline">
      {education.map((entry) => (
        <li class="entry entry--edu">
          <div class="entry__panel glass-deep" data-reveal>
            <div class="entry__meta">
              <p class="t-small entry__when">{entry.start} to {entry.end}</p>
              <p class="t-small entry__where">{entry.place}</p>
            </div>

            <h3 class="on-glass entry__role">{entry.role}</h3>
            <p class="t-small entry__org">{entry.org}</p>

            <ul class="entry__points">
              {entry.points.map((point) => (
                <li class="t-small on-glass-soft">{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <div class="certs glass-deep" data-reveal data-reveal-delay="90">
      <h3 class="t-eyebrow certs__title">Certificates</h3>
      <ul class="certs__list">
        {certificates.map((certificate) => (
          <li>
            <span class="on-glass certs__name">
              {certificate.url ? (
                <a href={certificate.url} target="_blank" rel="noopener noreferrer">
                  {certificate.name}
                </a>
              ) : (
                certificate.name
              )}
            </span>
            <span class="t-small certs__issuer">{certificate.issuer}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: var(--spacing-phi-3) 1rem;
  }

  .shell {
    width: min(100%, 68rem);
    margin-inline: auto;
  }
  .shell--narrow {
    width: min(100%, 52rem);
  }

  .head {
    max-width: 44ch;
    margin: 0 auto var(--spacing-phi-3);
    text-align: center;
  }
  .head__eyebrow { margin: 0 0 0.6rem; }
  .head__title   { margin: 0; }

  .timeline {
    display: grid;
    gap: var(--spacing-phi-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry__panel {
    padding: clamp(1.1rem, 2.2vw, 1.5rem);
    border-radius: 1.25rem;
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .entry__when,
  .entry__where {
    margin: 0;
    color: var(--ink-faint);
  }

  .entry__role {
    margin: 0;
    font-size: clamp(1.08rem, 1.5vw, 1.3rem);
    line-height: 1.22;
    letter-spacing: -0.008em;
    font-weight: 600;
  }
  .entry__org {
    margin: 0.2rem 0 0;
    color: var(--accent);
    font-weight: 500;
  }
  .entry--edu .entry__org {
    color: var(--sun-500);
  }
  :global(.dark) .entry--edu .entry__org {
    color: var(--sun-400);
  }

  .entry__points {
    display: grid;
    gap: 0.4rem;
    margin: var(--spacing-phi-1) 0 0;
    padding-left: 1.1rem;
  }
  .entry__points li {
    padding-left: 0.15rem;
  }
  .entry__points li::marker {
    color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .certs {
    margin-top: var(--spacing-phi-2);
    padding: clamp(1.1rem, 2.5vw, 1.618rem);
    border-radius: 1.5rem;
  }
  .certs__title {
    margin: 0 0 var(--spacing-phi-2);
    color: var(--accent);
  }
  .certs__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--spacing-phi-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .certs__list li {
    display: grid;
    gap: 0.15rem;
  }
  .certs__name {
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .certs__name a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .certs__issuer {
    color: var(--ink-faint);
  }

  /* Three roles side by side on a wide screen. The education slide keeps its
     single entry full width. */
  @media (min-width: 64rem) {
    .timeline--experience {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
