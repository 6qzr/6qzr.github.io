---
import "../styles/global.css";
import { person } from "../data/site";
import NatureScene from "../components/NatureScene.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * Whether this page is built from full-screen slides.
   *
   * Scroll snapping is opt-in per page, and must be. A page without slide
   * sections still has a footer, and `mandatory` snapping with a single snap
   * target pins the page to that target: the project pages opened at the
   * bottom and could not be scrolled back up.
   */
  slides?: boolean;
}

const { title, description = person.summary, slides = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og.jpg", Astro.site).toString();

/** JSON-LD matters here: this is a credibility site, so what a search engine
 *  and a link preview understand about him is part of the deliverable. */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.fullName,
  alternateName: person.name,
  url: Astro.site?.toString(),
  email: `mailto:${person.email}`,
  jobTitle: "Software Engineer",
  description: person.summary,
  address: { "@type": "PostalAddress", addressLocality: "Muscat", addressCountry: "OM" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Sultan Qaboos University" },
  knowsAbout: [
    "ASP.NET Core",
    "Entity Framework Core",
    "SQL Server",
    "Application security",
    "Vulnerability research",
    "Secure SDLC",
  ],
  sameAs: [person.github, person.linkedin],
};
---

<!doctype html>
<html lang="en" data-slides={slides ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    {/*
      viewport-fit=cover lets the fixed landscape run under the notch and the
      home indicator on an iPhone instead of being letterboxed by two grey
      bands. Everything that must stay clear of them pads itself with
      env(safe-area-inset-*), which is 0 everywhere else.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/* Tints the Safari chrome to match the page, so the browser does not
        frame a sky-blue site in white. */}
    <meta name="theme-color" content="#f2f8fd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081722" media="(prefers-color-scheme: dark)" />
    {/* Do not leak the visited path to sites they click through to. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Fonts first. They gate the first paint of text, and without the preload
      the page renders in the fallback and then reflows when the real font
      arrives. The metric-matched fallbacks in global.css make that swap
      invisible if it does happen; these make it usually not happen at all.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      crossorigin
    />

    {/*
      The backdrop is the largest paint on the page. Preloading it with the
      same srcset the <picture> uses means the browser starts the right file
      immediately, instead of waiting to discover it in the markup.
    */}
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/images/scene-1200.webp"
      imagesrcset="/images/scene-480.webp 480w, /images/scene-800.webp 800w, /images/scene-1200.webp 1200w, /images/scene-1670.webp 1670w"
      imagesizes="100vw"
      fetchpriority="high"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.fullName} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Theme must be resolved before first paint, otherwise the page renders in
      the wrong theme for a frame and visibly flashes. This is the one script
      that is deliberately render-blocking.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark =
            stored === "dark" ||
            (stored !== "light" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {
          /* Storage blocked: fall through to the light theme. */
        }
      })();
    </script>

    {/*
      `<` is escaped because JSON.stringify does not escape it, so a value
      containing `</script>` would close this block and everything after it
      would be parsed as markup. The data here is static, but this is the
      one place on the site where a string is written into a script element,
      so it should not depend on that staying true.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema).replace(/</g, "\\u003c")}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <NatureScene />

    {/*
      The leaf layer sits above the page, as in the brief. It is inert:
      pointer-events are off and it carries no information, so nothing is lost
      if the canvas never initialises.
    */}
    <canvas id="leaf-layer" aria-hidden="true"></canvas>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import { initTheme } from "../scripts/theme";
      import { initReveal } from "../scripts/reveal";
      import { initLeaves } from "../scripts/leaves";
      import { initSlides } from "../scripts/slides";

      initTheme();
      initReveal();
      initSlides();

      const canvas = document.getElementById("leaf-layer");
      if (canvas instanceof HTMLCanvasElement) initLeaves(canvas);
    </script>

    <style>
      #leaf-layer {
        position: fixed;
        inset: 0;
        z-index: 40;
        pointer-events: none;
      }

      main {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
